  \centering
  \caption{Resumo da estrutura e das partições da base de dados consolidada}
  \label{tab:resumo_dados}
  \small
  \begin{tabular}{>{\raggedright\arraybackslash}p{4.5cm} >{\raggedright\arraybackslash}p{3.0cm} >{\raggedright\arraybackslash}p{6.8cm}}
    \toprule
    \textbf{Indicador da Base de Dados} & \textbf{Valor} & \textbf{Papel na Estratégia de Modelagem} \\
